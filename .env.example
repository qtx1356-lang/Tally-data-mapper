# PORT: Platform-assigned port (defaults to 3000 in development/local)
PORT=3000

# HOST: Bind address for web server (defaults to 0.0.0.0 for cloud ingress)
HOST="0.0.0.0"

# NODE_ENV: Application environment ("production" or "development")
NODE_ENV="production"

# EXFIN_MODE: Target mode ("web" for cloud Node deployment, "desktop" for Electron)
EXFIN_MODE="web"

# STORAGE_MODE: Storage driver selection
# WEB + PRODUCTION: STORAGE_MODE=postgres (DATABASE_URL=REQUIRED)
# DESKTOP/LOCAL: STORAGE_MODE=local (DATABASE_URL=not required)
STORAGE_MODE="postgres"

# DATABASE_URL: PostgreSQL connection string (REQUIRED for WEB + production mode)
DATABASE_URL="postgres://user:password@localhost:5432/exfin_audit"

# TALLY_BRIDGE_URL: Optional authorized Tally gateway URL for cloud deployment
# When set in Web Mode, allows proxying requests to this explicit bridge only.
TALLY_BRIDGE_URL=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

